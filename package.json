{
  "name": "deca-study-app",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "check-ids": "node scripts/check-ids.mjs",
    "sync-roleplays": "node scripts/sync-roleplays.mjs",
    "prebuild": "node scripts/check-ids.mjs && npm run check-ids-new",
    "build": "vite build",
    "preview": "vite preview",
    "sync-new": "node scripts/sync-new-content.mjs",
    "check-ids-new": "node scripts/check-ids.mjs --string-ids --registry data/new_id_registry.json --cards public/new_flashcards.json --questions public/new_questions.json"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0"
  }
}
